{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Packy Codex Agent",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\MindDuet\\AgentKit\\mindduet-agent.cmd",
      "args": [
        "packy",
        "-ProjectRoot",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start DeepSeek Agent (Cheap Tasks)",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\MindDuet\\AgentKit\\mindduet-agent.cmd",
      "args": [
        "deepseek",
        "-ProjectRoot",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start Packy Codex Agent (Full Access)",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\MindDuet\\AgentKit\\mindduet-agent.cmd",
      "args": [
        "packy",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-FullAccess"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
